qmt_backtest_results/
venv/
.venv/
venv311/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ==================== 配置文件（不同步敏感信息） ====================
config/*.json
!config/*.example.json
!config/*.json.example
.env
.env.local
*.key
*.pem
*.cert

# ==================== 数据文件 ====================
*.pkl
*.parquet
*.csv
*.log
*.html
*.db
*.sqlite

